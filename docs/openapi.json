{
  "openapi": "3.1.0",
  "info": {
    "title": "Table Mutation Tracker scraper API",
    "description": "Called by the n8n orchestrator. Not intended for direct public use.",
    "version": "1.0.0"
  },
  "paths": {
    "/scrape": {
      "post": {
        "tags": [
          "Scraping"
        ],
        "summary": "Run a scrape",
        "description": "Log in to the SIS portal, scrape every configured class, and return the\nnormalized snapshot as JSON.\n\nWrites nothing. n8n commits the returned data to the data repo. Scrape\nfailures return HTTP 200 with `status: \"error\"` so n8n can branch on the body.",
        "operationId": "scrape_scrape_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/ScrapeSuccess"
                    },
                    {
                      "$ref": "#/components/schemas/ErrorResponse"
                    }
                  ],
                  "title": "Response 200 Scrape Scrape Post",
                  "discriminator": {
                    "propertyName": "status",
                    "mapping": {
                      "success": "#/components/schemas/ScrapeSuccess",
                      "error": "#/components/schemas/ErrorResponse"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid `X-Webhook-Secret` header."
          },
          "500": {
            "description": "`WEBHOOK_SECRET`, `GITHUB_TOKEN`, or `DATA_REPO` is not configured."
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ]
      }
    },
    "/append-index": {
      "post": {
        "tags": [
          "Rolling index"
        ],
        "summary": "Append a snapshot to the rolling index",
        "description": "Diff one snapshot against the previous index entry and append the result\nto `rolling_index.json`.\n\nCalled by n8n after each scrape. Re-appending a snapshot already in the index\nreplaces its entry in place.",
        "operationId": "append_index_append_index_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AppendIndexBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/AppendIndexSuccess"
                    },
                    {
                      "$ref": "#/components/schemas/ErrorResponse"
                    }
                  ],
                  "title": "Response 200 Append Index Append Index Post",
                  "discriminator": {
                    "propertyName": "status",
                    "mapping": {
                      "success": "#/components/schemas/AppendIndexSuccess",
                      "error": "#/components/schemas/ErrorResponse"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid `X-Webhook-Secret` header."
          },
          "500": {
            "description": "`WEBHOOK_SECRET`, `GITHUB_TOKEN`, or `DATA_REPO` is not configured."
          },
          "409": {
            "description": "The snapshot is older than the newest index entry. The body is `{\"detail\": {\"status\": \"needs-rebuild\", \"reason\": ...}}`; call `/rebuild-index`."
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ]
      }
    },
    "/rebuild-index": {
      "post": {
        "tags": [
          "Rolling index"
        ],
        "summary": "Rebuild the rolling index",
        "description": "Diff every consecutive pair of snapshots in the data repo and rewrite\n`rolling_index.json` from scratch.\n\nn8n calls this when `/append-index` returns 409. Run time grows with the\nnumber of snapshots; for large backfills use `scripts/rebuild_index.py`.",
        "operationId": "rebuild_index_rebuild_index_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/RebuildIndexSuccess"
                    },
                    {
                      "$ref": "#/components/schemas/ErrorResponse"
                    }
                  ],
                  "title": "Response 200 Rebuild Index Rebuild Index Post",
                  "discriminator": {
                    "propertyName": "status",
                    "mapping": {
                      "success": "#/components/schemas/RebuildIndexSuccess",
                      "error": "#/components/schemas/ErrorResponse"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid `X-Webhook-Secret` header."
          },
          "500": {
            "description": "`WEBHOOK_SECRET`, `GITHUB_TOKEN`, or `DATA_REPO` is not configured."
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ]
      }
    },
    "/health": {
      "get": {
        "tags": [
          "Operations"
        ],
        "summary": "Health check",
        "description": "Return `{\"status\": \"ok\"}` when every required environment variable is set.\nDoes not contact the SIS or GitHub.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthOk"
                }
              }
            }
          },
          "500": {
            "description": "One or more required environment variables are missing."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AppendIndexBody": {
        "properties": {
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "title": "Date",
            "description": "Snapshot date, `YYYY-MM-DD`.",
            "examples": [
              "2026-06-05"
            ]
          },
          "time": {
            "type": "string",
            "pattern": "^\\d{6}$",
            "title": "Time",
            "description": "Snapshot time, `HHMMSS`.",
            "examples": [
              "153000"
            ]
          }
        },
        "type": "object",
        "required": [
          "date",
          "time"
        ],
        "title": "AppendIndexBody"
      },
      "AppendIndexSuccess": {
        "properties": {
          "status": {
            "type": "string",
            "const": "success",
            "title": "Status"
          },
          "snapshots": {
            "type": "integer",
            "title": "Snapshots",
            "description": "Number of entries in the rolling index."
          },
          "entry": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/IndexEntry"
              },
              {
                "type": "null"
              }
            ],
            "description": "The entry for the appended snapshot."
          }
        },
        "type": "object",
        "required": [
          "status",
          "snapshots",
          "entry"
        ],
        "title": "AppendIndexSuccess"
      },
      "Assignment": {
        "properties": {
          "due_date": {
            "type": "string",
            "title": "Due Date"
          },
          "category": {
            "type": "string",
            "title": "Category"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "flags": {
            "additionalProperties": {
              "type": "boolean"
            },
            "type": "object",
            "title": "Flags"
          },
          "score_raw": {
            "type": "string",
            "title": "Score Raw"
          },
          "points_earned": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Points Earned"
          },
          "points_possible": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Points Possible"
          },
          "percent": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Percent"
          },
          "grade": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Grade"
          },
          "has_comments": {
            "type": "boolean",
            "title": "Has Comments"
          }
        },
        "type": "object",
        "required": [
          "due_date",
          "category",
          "name",
          "flags",
          "score_raw",
          "points_earned",
          "points_possible",
          "percent",
          "grade",
          "has_comments"
        ],
        "title": "Assignment"
      },
      "ClassMetadata": {
        "properties": {
          "course": {
            "type": "string",
            "title": "Course"
          },
          "teacher": {
            "type": "string",
            "title": "Teacher"
          },
          "expression": {
            "type": "string",
            "title": "Expression"
          },
          "term": {
            "type": "string",
            "title": "Term"
          },
          "final_grade": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Final Grade"
          },
          "final_percent": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Final Percent"
          },
          "assignment_count": {
            "type": "integer",
            "title": "Assignment Count"
          },
          "last_updated": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Updated"
          }
        },
        "type": "object",
        "required": [
          "course",
          "teacher",
          "expression",
          "term",
          "final_grade",
          "final_percent",
          "assignment_count",
          "last_updated"
        ],
        "title": "ClassMetadata"
      },
      "ErrorResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "error",
            "title": "Status"
          },
          "error": {
            "type": "string",
            "title": "Error",
            "description": "Exception message with URLs replaced by `<url>`. The full message is in the scraper logs."
          },
          "error_id": {
            "type": "string",
            "title": "Error Id",
            "description": "Short id that locates the full stack trace in the scraper logs."
          }
        },
        "type": "object",
        "required": [
          "status",
          "error",
          "error_id"
        ],
        "title": "ErrorResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthOk": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "HealthOk"
      },
      "IndexChanges": {
        "properties": {
          "class_level": {
            "type": "integer",
            "title": "Class Level",
            "description": "Class-level changes, such as a final grade change."
          },
          "added": {
            "type": "integer",
            "title": "Added",
            "description": "Assignments added since the previous snapshot."
          },
          "modified": {
            "type": "integer",
            "title": "Modified",
            "description": "Assignments modified since the previous snapshot."
          },
          "deleted": {
            "type": "integer",
            "title": "Deleted",
            "description": "Assignments deleted since the previous snapshot."
          },
          "total": {
            "type": "integer",
            "title": "Total",
            "description": "Assignment changes: added + modified + deleted."
          }
        },
        "type": "object",
        "required": [
          "class_level",
          "added",
          "modified",
          "deleted",
          "total"
        ],
        "title": "IndexChanges"
      },
      "IndexClassSummary": {
        "properties": {
          "course": {
            "type": "string",
            "title": "Course",
            "description": "Course name."
          },
          "final_grade": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Final Grade",
            "description": "Final letter grade, or null when not posted."
          },
          "final_percent": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Final Percent",
            "description": "Final percent, or null when not posted."
          },
          "assignment_count": {
            "type": "integer",
            "title": "Assignment Count",
            "description": "Number of assignments in the class."
          }
        },
        "type": "object",
        "required": [
          "course",
          "final_grade",
          "final_percent",
          "assignment_count"
        ],
        "title": "IndexClassSummary"
      },
      "IndexEntry": {
        "properties": {
          "date": {
            "type": "string",
            "title": "Date",
            "description": "Snapshot date, `YYYY-MM-DD`."
          },
          "time": {
            "type": "string",
            "title": "Time",
            "description": "Snapshot time, `HHMMSS`."
          },
          "scrape_timestamp": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Scrape Timestamp",
            "description": "ISO 8601 timestamp of the scrape."
          },
          "previous_snapshot": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Previous Snapshot",
            "description": "Previous snapshot as `YYYY-MM-DD/HHMMSS`, or null for the first."
          },
          "changes": {
            "$ref": "#/components/schemas/IndexChanges"
          },
          "classes": {
            "additionalProperties": {
              "$ref": "#/components/schemas/IndexClassSummary"
            },
            "type": "object",
            "title": "Classes",
            "description": "Keyed by class slug."
          },
          "gpa": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Gpa",
            "description": "Weighted GPA, or null when it cannot be computed."
          }
        },
        "type": "object",
        "required": [
          "date",
          "time",
          "scrape_timestamp",
          "previous_snapshot",
          "changes",
          "classes",
          "gpa"
        ],
        "title": "IndexEntry"
      },
      "RebuildIndexSuccess": {
        "properties": {
          "status": {
            "type": "string",
            "const": "success",
            "title": "Status"
          },
          "snapshots": {
            "type": "integer",
            "title": "Snapshots",
            "description": "Number of entries in the rolling index."
          },
          "total_changes": {
            "type": "integer",
            "title": "Total Changes",
            "description": "Assignment changes summed across all entries."
          }
        },
        "type": "object",
        "required": [
          "status",
          "snapshots",
          "total_changes"
        ],
        "title": "RebuildIndexSuccess"
      },
      "ScrapeData": {
        "properties": {
          "date": {
            "type": "string",
            "title": "Date",
            "description": "Snapshot date, `YYYY-MM-DD`."
          },
          "time": {
            "type": "string",
            "title": "Time",
            "description": "Snapshot time, `HHMMSS`."
          },
          "scrape_timestamp": {
            "type": "string",
            "title": "Scrape Timestamp",
            "description": "ISO 8601 timestamp of the scrape."
          },
          "classes": {
            "items": {
              "$ref": "#/components/schemas/ScrapedClass"
            },
            "type": "array",
            "title": "Classes"
          },
          "metadata": {
            "$ref": "#/components/schemas/ScrapeMetadata"
          }
        },
        "type": "object",
        "required": [
          "date",
          "time",
          "scrape_timestamp",
          "classes",
          "metadata"
        ],
        "title": "ScrapeData"
      },
      "ScrapeMetadata": {
        "properties": {
          "scrape_timestamp": {
            "type": "string",
            "title": "Scrape Timestamp",
            "description": "ISO 8601 timestamp of the scrape."
          },
          "source": {
            "type": "string",
            "title": "Source",
            "description": "Source key, always `sis`."
          },
          "classes": {
            "additionalProperties": {
              "$ref": "#/components/schemas/ClassMetadata"
            },
            "type": "object",
            "title": "Classes",
            "description": "Class metadata keyed by class slug. Committed as `metadata.json`."
          }
        },
        "type": "object",
        "required": [
          "scrape_timestamp",
          "source",
          "classes"
        ],
        "title": "ScrapeMetadata"
      },
      "ScrapeSuccess": {
        "properties": {
          "status": {
            "type": "string",
            "const": "success",
            "title": "Status"
          },
          "data": {
            "$ref": "#/components/schemas/ScrapeData"
          }
        },
        "type": "object",
        "required": [
          "status",
          "data"
        ],
        "title": "ScrapeSuccess"
      },
      "ScrapedClass": {
        "properties": {
          "slug": {
            "type": "string",
            "title": "Slug",
            "description": "Class slug from `config/sources.json`."
          },
          "assignments": {
            "items": {
              "$ref": "#/components/schemas/Assignment"
            },
            "type": "array",
            "title": "Assignments"
          },
          "metadata": {
            "$ref": "#/components/schemas/ClassMetadata"
          }
        },
        "type": "object",
        "required": [
          "slug",
          "assignments",
          "metadata"
        ],
        "title": "ScrapedClass"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "APIKeyHeader": {
        "type": "apiKey",
        "description": "Shared secret configured as `WEBHOOK_SECRET` on the scraper and as a Header Auth credential in n8n.",
        "in": "header",
        "name": "X-Webhook-Secret"
      }
    }
  },
  "servers": [
    {
      "url": "https://scraper.example.com",
      "description": "Your scraper deployment"
    }
  ]
}
